# ==============================================================================
# SYNAPTRA Multi-Agent System & Vector Memory Configuration
# ==============================================================================

# Lyzr Agent API Key (Studio API Key with inference permissions)
LYZR_API_KEY=your_lyzr_api_key_here

# 1. Planner Agent: Decomposes high-level user tasks into sequential action plans
LYZR_PLANNER_AGENT_ID=your_planner_agent_id_here

# 2. Executor Agent: Implements and executes assigned subtasks
LYZR_EXECUTOR_AGENT_ID=your_executor_agent_id_here

# 3. Memory Agent: Synthesizes context from Qdrant vector memory and proposes memories
LYZR_MEMORY_AGENT_ID=your_memory_agent_id_here

# 4. Reviewer Agent: Audits results, checks for missing work, and produces final answer
LYZR_REVIEWER_AGENT_ID=your_reviewer_agent_id_here

# ==============================================================================
# Qdrant Vector Database (Local Docker or Qdrant Cloud Cluster)
# ==============================================================================
# Local: http://127.0.0.1:6333
# Cloud: https://xxxx-xxxx.gcp.cloud.qdrant.io:6333
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=synaptra_memory
# Optional: Set for Qdrant Cloud
QDRANT_API_KEY=

# ==============================================================================
# Google Gemini AI Studio (Self-Healing Fallback & AI Copilot Chat)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here

# ==============================================================================
# Frontend Environment Variable (Vercel Production vs Local Dev)
# ==============================================================================
# For local dev: http://127.0.0.1:8002
# For Vercel production: leave empty to use relative same-origin /api routes
VITE_API_BASE_URL=
